# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables)

# --- Banco de dados (use UM dos dois) ---
# Opção 1 — Neon (recomendado na Vercel): a integração Neon cria DATABASE_URL sozinha.
# A tabela é criada automaticamente no primeiro acesso.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Opção 2 — Supabase (rode supabase/schema.sql antes)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=chave-service-role-do-supabase
# Sem nenhum banco o app roda em "modo local" (dados só no navegador).

# --- Acesso ---
# PIN/senha que vocês dois usam para entrar no app. Sem ele o app fica aberto.
APP_PIN=1234
# Texto aleatório longo, usado para assinar o login (ex.: gere em https://1password.com/password-generator)
APP_SECRET=troque-por-um-texto-aleatorio-bem-grande

# --- WhatsApp ---
# Token que o provedor de WhatsApp envia (?token=... ou header x-webhook-token).
# Para a API oficial da Meta, é também o "Verify token" do webhook.
WHATSAPP_WEBHOOK_TOKEN=um-token-secreto
# (Opcional) API oficial da Meta (WhatsApp Cloud API) — para o app responder a mensagem
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
